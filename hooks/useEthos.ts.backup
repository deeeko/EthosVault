'use client';

import { useEffect, useState } from 'react';
import { useAccount } from 'wagmi';

interface EthosProfile {
  score: number;
  address: string;
  verified: boolean;
}

export function useEthos() {
  const { address, isConnected } = useAccount();
  const [ethosProfile, setEthosProfile] = useState<EthosProfile | null>(null);
  const [loading, setLoading] = useState(false);

  useEffect(() => {
    if (address && isConnected) {
      fetchEthosProfile(address);
    } else {
      setEthosProfile(null);
    }
  }, [address, isConnected]);

  const fetchEthosProfile = async (walletAddress: string) => {
    setLoading(true);
    try {
      // Ethos API call - using their attestation service
      const response = await fetch(
        `https://api.ethos.network/api/v1/attestations/address/${walletAddress}`
      );
      
      if (response.ok) {
        const data = await response.json();
        // Calculate score based on attestations
        const score = calculateEthosScore(data);
        setEthosProfile({
          score,
          address: walletAddress,
          verified: data.verified || false,
        });
      } else {
        // No Ethos profile yet - set default
        setEthosProfile({
          score: 0,
          address: walletAddress,
          verified: false,
        });
      }
    } catch (error) {
      console.error('Error fetching Ethos profile:', error);
      // Fallback to mock data for demo
      setEthosProfile({
        score: 1850,
        address: walletAddress,
        verified: false,
      });
    } finally {
      setLoading(false);
    }
  };

  const calculateEthosScore = (data: any): number => {
    // Calculate score based on Ethos attestations
    // This is a simplified version - adjust based on actual Ethos API response
    if (!data || !data.attestations) return 0;
    
    const positiveCount = data.attestations.filter((a: any) => a.score > 0).length;
    const negativeCount = data.attestations.filter((a: any) => a.score < 0).length;
    
    return Math.max(0, Math.min(2800, (positiveCount * 100) - (negativeCount * 50)));
  };

  const connectEthos = async () => {
    if (!address) return;
    
    // Open Ethos verification flow
    window.open(
      `https://ethos.network/verify?address=${address}&callback=${window.location.origin}/profile`,
      '_blank'
    );
  };

  return {
    ethosProfile,
    loading,
    connectEthos,
  };
}