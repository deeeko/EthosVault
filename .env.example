# WalletConnect Project ID
# Get from: https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Blockchain Network
# 8453 = Base Mainnet, 84532 = Base Sepolia Testnet
NEXT_PUBLIC_CHAIN_ID=8453

# EthosVault Smart Contract Address
# Deploy your contract first, then add the address here
NEXT_PUBLIC_CONTRACT_ADDRESS=0xYourDeployedContractAddressHere

# Session Management Secret
# Generate a random 32+ character string
SESSION_SECRET=your_random_session_secret_minimum_32_characters

# NFT API Keys (Optional - for fetching user's NFTs)
# Simplehash API: https://simplehash.com/
NEXT_PUBLIC_SIMPLEHASH_API_KEY=your_simplehash_api_key

# Alchemy API: https://www.alchemy.com/
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key

# Note: At least one NFT API key is recommended for Lend page functionality
# Without API keys, the app will show mock/demo NFTs
